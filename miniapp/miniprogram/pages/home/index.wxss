.home-page { padding-bottom: calc(172rpx + env(safe-area-inset-bottom)); }

.hero-card {
  position: relative;
  height: 472rpx;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #12295a 0%, #0d5ae5 60%, #00a7c4 100%);
  box-shadow: 0 18rpx 42rpx rgba(23,105,245,.25);
}

.hero-card::after {
  content: "";
  position: absolute;
  width: 470rpx;
  height: 470rpx;
  right: -230rpx;
  top: -240rpx;
  border: 1rpx solid rgba(255,255,255,.18);
  border-radius: 50%;
  box-shadow: 0 0 0 55rpx rgba(255,255,255,.035), 0 0 0 116rpx rgba(255,255,255,.025);
}

.hero-top { position: relative; z-index: 3; display: flex; justify-content: space-between; align-items: flex-start; }
.hero-top > view:first-child { min-width: 0; flex: 1; padding-right: 16rpx; }
.vehicle-name { max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 36rpx; font-weight: 800; }
.hero-updated { margin-top: 8rpx; font-size: 21rpx; color: rgba(255,255,255,.68); }
.online-chip { flex: none; height: 52rpx; padding: 0 18rpx; border-radius: 26rpx; background: rgba(4,31,76,.3); display: flex; align-items: center; font-size: 22rpx; font-weight: 750; white-space: nowrap; }

.vehicle-stage { position: relative; z-index: 2; height: 240rpx; }
.soc-gauge { position: absolute; left: 0; top: 54rpx; width: 146rpx; height: 146rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: conic-gradient(#4bf0ae 0 var(--soc), rgba(255,255,255,.16) var(--soc) 100%); }
.soc-gauge-inner { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(16,55,126,.96); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.soc-value { font-size: 38rpx; line-height: 1; font-weight: 800; }
.soc-label { margin-top: 9rpx; color: rgba(255,255,255,.7); font-size: 18rpx; }
.vehicle-image { position: absolute; width: 390rpx; height: 188rpx; left: 138rpx; top: 27rpx; }
.range-block { position: absolute; right: 0; top: 76rpx; text-align: right; }
.range-value { font-size: 43rpx; line-height: 1; font-weight: 800; }
.range-label { margin-top: 10rpx; color: rgba(255,255,255,.68); font-size: 18rpx; }

.state-rail { position: relative; z-index: 3; height: 82rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255,255,255,.2); display: grid; grid-template-columns: repeat(3,1fr); }
.state-cell { text-align: center; border-right: 1rpx solid rgba(255,255,255,.16); }
.state-cell:last-child { border-right: 0; }
.state-cell text { display: block; font-size: 23rpx; font-weight: 750; }
.state-cell text:last-child { margin-top: 6rpx; color: rgba(255,255,255,.6); font-size: 17rpx; font-weight: 500; }

.live-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 14rpx; }
.live-card { min-width: 0; min-height: 112rpx; padding: 20rpx 22rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: none; }
.live-card > view:first-child { min-width: 0; }
.environment-card { background: #edfbf6; border-color: #d5f2e7; }
.voltage-card { background: #fff8e8; border-color: #f8e6b9; }
.mileage-card { background: #eef4ff; border-color: #dce8ff; }
.connection-card { background: #fff0f2; border-color: #ffdde1; }
.live-label { color: #718096; font-size: 19rpx; }
.live-title { max-width: 100%; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; font-size: 29rpx; font-weight: 800; white-space: nowrap; }
.temperature-pair { display: flex; gap: 26rpx; text-align: right; }
.temperature-pair view text { display: block; font-size: 28rpx; font-weight: 800; }
.temperature-pair view text:last-child { margin-top: 4rpx; color: #718096; font-size: 17rpx; font-weight: 500; }
.mini-icon { width: 58rpx; height: 58rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; }
.mini-icon image { width: 30rpx; height: 30rpx; }
.mini-icon.yellow { background: #f3ad22; }
.mini-icon.blue { background: #1769f5; }
.mini-icon.coral { background: #f25d66; }

.today-card { position: relative; height: 142rpx; padding: 24rpx 26rpx; overflow: hidden; border-left: 7rpx solid #12ad7b; box-shadow: none; }
.today-distance text:first-child { color: #087a59; font-size: 43rpx; font-weight: 800; }
.today-distance text:nth-child(2) { margin-left: 6rpx; color: #718096; font-size: 22rpx; }
.today-distance text:last-child { display: block; margin-top: 5rpx; color: #718096; font-size: 19rpx; }
.today-meta { position: absolute; right: 24rpx; top: 26rpx; max-width: 250rpx; text-align: right; }
.today-meta text { display: block; color: #718096; font-size: 19rpx; }
.today-meta text:first-child { color: #142038; font-size: 24rpx; font-weight: 800; }
.trend-line { position: absolute; left: 28rpx; right: 210rpx; bottom: 17rpx; height: 24rpx; border-top: 3rpx solid rgba(18,173,123,.18); transform: skewY(-4deg); }
.trend-line view { margin: -9rpx 30rpx 0; height: 18rpx; border-top: 5rpx solid #12ad7b; border-radius: 50%; transform: skewY(9deg); }

.quick-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 12rpx; }
.quick-card { height: 116rpx; padding: 14rpx 6rpx; text-align: center; box-shadow: none; }
.quick-icon { width: 48rpx; height: 48rpx; margin: 0 auto 10rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; }
.quick-icon image { width: 27rpx; height: 27rpx; }
.quick-title { overflow: hidden; text-overflow: ellipsis; font-size: 21rpx; font-weight: 750; white-space: nowrap; }
.tone-blue { background: #eef4ff; border-color: #dce8ff; } .tone-blue .quick-icon { background: #1769f5; }
.tone-green { background: #edfbf6; border-color: #d5f2e7; } .tone-green .quick-icon { background: #12ad7b; }
.tone-coral { background: #fff0f2; border-color: #ffdde1; } .tone-coral .quick-icon { background: #f25d66; }
.tone-yellow { background: #fff8e8; border-color: #f8e6b9; } .tone-yellow .quick-icon { background: #f3ad22; }

.loading-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.loading-grid view { height: 112rpx; }
.retry-button, .bind-button { width: 280rpx; margin-top: 30rpx; }
