<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- DiLink dependencies are pinned and upgraded only after explicit device compatibility tests. -->
    <issue id="GradleDependency" severity="ignore" />

    <!-- Adaptive icons require this qualifier even though the app's minSdk is newer than API 26. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!--
      These 96x16 files are the firmware-authored FA preset animations. Lossless animated WebP
      increased their combined size by 13%, while lossy conversion damages the pixel preview.
      Keep this exception limited to the exact 01..20 asset set.
    -->
    <issue id="GifUsage">
        <ignore regexp=".*drawable-nodpi/ipixel_fa_preset_(0[1-9]|1[0-9]|20)\.gif" />
    </issue>
</lint>
