.trips-page { padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.segment-control { height: 76rpx; padding: 7rpx; margin-bottom: 18rpx; background: #e9eef6; border-radius: 16rpx; display: grid; grid-template-columns: 1fr 1fr; }
.segment-item { border-radius: 11rpx; display: flex; align-items: center; justify-content: center; color: #718096; font-size: 25rpx; font-weight: 750; }
.segment-item.active { color: #1769f5; background: #ffffff; box-shadow: 0 5rpx 16rpx rgba(23,61,120,.1); }
.map-card { position: relative; height: 430rpx; overflow: hidden; }
.route-map { width: 100%; height: 100%; }
.latest-chip { position: absolute; left: 20rpx; top: 20rpx; height: 54rpx; padding: 0 18rpx; border-radius: 12rpx; display: flex; align-items: center; background: rgba(255,255,255,.94); color: #344259; font-size: 21rpx; font-weight: 700; box-shadow: 0 8rpx 20rpx rgba(20,42,79,.12); }
.summary-card { margin-top: 16rpx; padding: 24rpx 10rpx; display: grid; grid-template-columns: repeat(3,1fr); box-shadow: none; }
.summary-card view { text-align: center; border-right: 1rpx solid #e7ecf3; }
.summary-card view:last-child { border-right: 0; }
.summary-card text { display: block; font-size: 28rpx; font-weight: 800; }
.summary-card text:last-child { margin-top: 7rpx; color: #718096; font-size: 18rpx; font-weight: 500; }
.trip-row { min-height: 118rpx; margin-bottom: 14rpx; padding: 18rpx 20rpx; display: grid; grid-template-columns: 76rpx 1fr auto; gap: 18rpx; align-items: center; box-shadow: none; }
.trip-copy { min-width: 0; }
.date-tile { width: 74rpx; height: 74rpx; border-radius: 14rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 800; }
.date-tile text { font-size: 18rpx; line-height: 1.15; }
.date-tile text:last-child { margin-top: 4rpx; font-size: 22rpx; }
.date-blue { color: #1769f5; background: #edf3ff; }
.date-green { color: #0b8d66; background: #e9f8f2; }
.date-yellow { color: #c47a07; background: #fff4e2; }
.date-coral { color: #d84752; background: #fff0f2; }
.trip-copy view { font-size: 25rpx; font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.trip-copy text { display: block; margin-top: 7rpx; color: #718096; font-size: 18rpx; }
.consumption { flex: none; color: #0a9b6e; text-align: right; }
.consumption text { display: block; font-size: 24rpx; font-weight: 800; }
.consumption text:last-child { margin-top: 4rpx; font-size: 14rpx; font-weight: 500; color: #8a97a9; }
.charge-summary { display: grid; grid-template-columns: 1fr 1.15fr; gap: 14rpx; }
.charge-total, .charge-tip { min-height: 160rpx; padding: 24rpx; box-shadow: none; }
.charge-total { color: #ffffff; background: #1769f5; border-color: #1769f5; display: flex; align-items: center; gap: 20rpx; }
.charge-icon { width: 58rpx; height: 58rpx; border-radius: 15rpx; background: rgba(255,255,255,.18); display: flex; align-items: center; justify-content: center; }
.charge-icon image { width: 31rpx; height: 31rpx; }
.charge-total text { display: block; font-size: 20rpx; color: rgba(255,255,255,.7); }
.charge-total text:last-child { margin-top: 6rpx; color: #ffffff; font-size: 32rpx; font-weight: 800; }
.charge-tip { background: #edfbf6; border-color: #d5f2e7; display: flex; flex-direction: column; justify-content: center; }
.charge-tip text { color: #087a59; font-size: 22rpx; font-weight: 750; }
.charge-tip text:last-child { margin-top: 10rpx; color: #718096; font-size: 18rpx; font-weight: 500; line-height: 1.5; }
.charge-row { min-height: 126rpx; margin-bottom: 14rpx; padding: 20rpx; display: grid; grid-template-columns: 74rpx 1fr auto; gap: 18rpx; align-items: center; box-shadow: none; }
.charge-copy { min-width: 0; }
.charge-date { width: 70rpx; height: 76rpx; border-radius: 14rpx; background: #edfbf6; color: #0b8d66; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.charge-date text:first-child { font-size: 28rpx; font-weight: 800; }.charge-date text:last-child { font-size: 17rpx; }
.charge-copy view { display: flex; align-items: center; gap: 12rpx; }.charge-copy view text:first-child { font-size: 25rpx; font-weight: 800; }.charge-copy view text:last-child { color: #1769f5; background: #edf3ff; border-radius: 12rpx; padding: 3rpx 10rpx; font-size: 17rpx; }
.charge-copy > text { display: block; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; color: #718096; font-size: 19rpx; white-space: nowrap; }
.charge-cost { flex: none; color: #087a59; font-size: 25rpx; font-weight: 800; white-space: nowrap; }
.record-skeleton { height: 118rpx; margin-top: 24rpx; }.summary-card.skeleton { height: 102rpx; }.retry-button { width: 280rpx; margin-top: 28rpx; }
.compact-empty { min-height: 190rpx; padding: 34rpx; display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:none }
