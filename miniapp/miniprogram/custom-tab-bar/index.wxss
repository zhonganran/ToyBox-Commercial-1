.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx env(safe-area-inset-bottom);
  background: rgba(255,255,255,.98);
  border-top: 1rpx solid #e7ecf3;
  box-shadow: 0 -10rpx 30rpx rgba(24, 53, 101, .06);
}

.tab-bar {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  width: 25%;
  height: 96rpx;
  color: #8794a8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon-wrap {
  width: 54rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon { width: 42rpx; height: 42rpx; }
.tab-label { margin-top: 3rpx; font-size: 20rpx; line-height: 24rpx; }
.selected { color: #1769f5; font-weight: 800; }
