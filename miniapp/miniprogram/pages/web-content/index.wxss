.content-page{min-height:100vh;padding:0 28rpx 60rpx;background:#f4f7fb}.detail-header{padding-top:calc(env(safe-area-inset-top) + 24rpx);min-height:150rpx;display:grid;grid-template-columns:64rpx 1fr 176rpx;gap:16rpx;align-items:end;padding-bottom:20rpx}.back-button{width:58rpx;height:58rpx;border-radius:15rpx;background:#fff;border:1rpx solid #e7ecf3;display:flex;align-items:center;justify-content:center}.back-button image{width:28rpx;height:28rpx}.detail-title{font-size:36rpx;font-weight:800}.detail-caption{margin-top:6rpx;color:#718096;font-size:21rpx}
.content-hero{min-height:302rpx;padding:34rpx;border-radius:18rpx;color:#fff;box-shadow:0 18rpx 42rpx rgba(23,74,160,.2)}.hero-blue{background:linear-gradient(145deg,#163f89,#1769f5,#08a7c5)}.hero-green{background:linear-gradient(145deg,#0b7357,#12ad7b,#40cba0)}.hero-coral{background:linear-gradient(145deg,#b93747,#f25d66,#f58978)}.hero-yellow{background:linear-gradient(145deg,#a96500,#f3ad22,#f7ca50)}.hero-cyan{background:linear-gradient(145deg,#087a93,#08a7c5,#48cada)}.hero-violet{background:linear-gradient(145deg,#44359a,#6758d7,#8d7ee8)}
.content-icon{width:76rpx;height:76rpx;border-radius:18rpx;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center}.content-icon image{width:40rpx;height:40rpx}.content-title{margin-top:28rpx;font-size:40rpx;font-weight:800}.content-description{margin-top:14rpx;color:rgba(255,255,255,.74);font-size:22rpx;line-height:1.65}
.content-list{padding:0 24rpx;box-shadow:none}.content-row{min-height:104rpx;display:grid;grid-template-columns:20rpx 1fr 26rpx;gap:17rpx;align-items:center;border-bottom:1rpx solid #e7ecf3}.content-row:last-child{border-bottom:0}.content-row>text{font-size:25rpx;font-weight:750}.content-row image{width:25rpx;height:25rpx;opacity:.45}.row-dot{width:13rpx;height:13rpx;border-radius:50%}.dot-blue{background:#1769f5}.dot-green{background:#12ad7b}.dot-coral{background:#f25d66}.dot-yellow{background:#f3ad22}.dot-cyan{background:#08a7c5}.dot-violet{background:#6758d7}
.update-panel{margin-top:18rpx;padding:24rpx;box-shadow:none}.update-panel>view{display:flex;align-items:center;justify-content:space-between}.update-panel>view text{color:#718096;font-size:20rpx}.update-panel>view view{color:#1769f5;font-size:30rpx;font-weight:800}.update-panel>text{display:block;margin-top:16rpx;color:#55647a;font-size:21rpx;line-height:1.6}.action-button{margin-top:22rpx}.action-status{text-align:center;margin-top:16rpx;color:#0a8c64;font-size:21rpx;font-weight:700}.safety-panel{margin-top:22rpx;padding:24rpx;display:flex;gap:18rpx;align-items:flex-start;box-shadow:none}.safety-panel image{width:42rpx;height:42rpx}.safety-panel view view{font-size:24rpx;font-weight:800}.safety-panel view text{display:block;margin-top:7rpx;color:#718096;font-size:20rpx;line-height:1.6}
