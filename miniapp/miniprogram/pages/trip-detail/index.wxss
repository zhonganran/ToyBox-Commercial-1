.detail-page{min-height:100vh;padding:0 28rpx 60rpx;background:#f4f7fb}.detail-header{padding-top:calc(env(safe-area-inset-top) + 24rpx);min-height:150rpx;display:grid;grid-template-columns:64rpx 1fr 176rpx;gap:16rpx;align-items:end;padding-bottom:20rpx}.back-button{width:58rpx;height:58rpx;border-radius:15rpx;background:#fff;border:1rpx solid #e7ecf3;display:flex;align-items:center;justify-content:center}.back-button image{width:28rpx;height:28rpx}.detail-title{font-size:36rpx;font-weight:800}.detail-caption{margin-top:6rpx;color:#718096;font-size:21rpx}
.detail-map{height:520rpx;overflow:hidden}.route-map{width:100%;height:100%}.route-title{margin-top:16rpx;padding:25rpx;display:grid;grid-template-columns:24rpx 1fr;gap:9rpx 16rpx;align-items:center;box-shadow:none}.route-point{width:18rpx;height:18rpx;border-radius:50%;border:5rpx solid #fff;box-shadow:0 2rpx 8rpx rgba(20,32,56,.18)}.route-point.start{background:#12ad7b}.route-point.end{background:#f25d66}.route-title view view{font-size:25rpx;font-weight:800}.route-title view text{display:block;margin-top:4rpx;color:#718096;font-size:18rpx}.route-divider{width:2rpx;height:28rpx;margin-left:8rpx;background:#d7dee8}
.route-unavailable{min-height:240rpx;padding:38rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-shadow:none}
.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.metric{min-height:150rpx;padding:24rpx 12rpx;text-align:center;box-shadow:none}.metric>text:first-child{font-size:38rpx;font-weight:800}.metric>text:nth-child(2){margin-left:4rpx;color:#718096;font-size:16rpx}.metric view{margin-top:12rpx;color:#718096;font-size:19rpx}.metric.blue{background:#eef4ff;border-color:#dce8ff}.metric.green{background:#edfbf6;border-color:#d5f2e7}.metric.yellow{background:#fff8e8;border-color:#f8e6b9}.data-note{margin-top:20rpx;padding:24rpx;display:flex;gap:18rpx;align-items:flex-start;box-shadow:none}.data-note image{width:38rpx;height:38rpx;flex:none}.data-note text{color:#718096;font-size:20rpx;line-height:1.65}
