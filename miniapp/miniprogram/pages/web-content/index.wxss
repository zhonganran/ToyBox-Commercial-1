.content-page{min-height:100vh;padding:0 28rpx 60rpx;background:#f4f7fb}.detail-header{padding-top:calc(env(safe-area-inset-top) + 24rpx);min-height:150rpx;display:grid;grid-template-columns:64rpx 1fr 176rpx;gap:16rpx;align-items:end;padding-bottom:20rpx}.back-button{width:58rpx;height:58rpx;border-radius:15rpx;background:#fff;border:1rpx solid #e7ecf3;display:flex;align-items:center;justify-content:center}.back-button image{width:28rpx;height:28rpx}.detail-title{font-size:36rpx;font-weight:800}.detail-caption{margin-top:6rpx;color:#718096;font-size:21rpx}
.content-hero{min-height:302rpx;padding:34rpx;border-radius:18rpx;color:#fff;box-shadow:0 18rpx 42rpx rgba(23,74,160,.2)}.hero-blue{background:linear-gradient(145deg,#163f89,#1769f5,#08a7c5)}.hero-green{background:linear-gradient(145deg,#0b7357,#12ad7b,#40cba0)}.hero-coral{background:linear-gradient(145deg,#b93747,#f25d66,#f58978)}.hero-yellow{background:linear-gradient(145deg,#a96500,#f3ad22,#f7ca50)}.hero-cyan{background:linear-gradient(145deg,#087a93,#08a7c5,#48cada)}.hero-violet{background:linear-gradient(145deg,#44359a,#6758d7,#8d7ee8)}
.content-icon{width:76rpx;height:76rpx;border-radius:18rpx;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center}.content-icon image{width:40rpx;height:40rpx}.content-title{margin-top:28rpx;font-size:40rpx;font-weight:800}.content-description{margin-top:14rpx;color:rgba(255,255,255,.74);font-size:22rpx;line-height:1.65}
.content-list{padding:0 24rpx;box-shadow:none}.content-row{min-height:104rpx;display:grid;grid-template-columns:20rpx 1fr 26rpx;gap:17rpx;align-items:center;border-bottom:1rpx solid #e7ecf3}.content-row:last-child{border-bottom:0}.content-row>text{font-size:25rpx;font-weight:750}.content-row image{width:25rpx;height:25rpx;opacity:.45}.row-dot{width:13rpx;height:13rpx;border-radius:50%}.dot-blue{background:#1769f5}.dot-green{background:#12ad7b}.dot-coral{background:#f25d66}.dot-yellow{background:#f3ad22}.dot-cyan{background:#08a7c5}.dot-violet{background:#6758d7}
.update-panel{margin-top:18rpx;padding:24rpx;box-shadow:none}.update-panel>view{display:flex;align-items:center;justify-content:space-between}.update-panel>view text{color:#718096;font-size:20rpx}.update-panel>view view{color:#1769f5;font-size:30rpx;font-weight:800}.update-panel>text{display:block;margin-top:16rpx;color:#55647a;font-size:21rpx;line-height:1.6}.action-button{margin-top:22rpx}.action-status{text-align:center;margin-top:16rpx;color:#0a8c64;font-size:21rpx;font-weight:700}.safety-panel{margin-top:22rpx;padding:24rpx;display:flex;gap:18rpx;align-items:flex-start;box-shadow:none}.safety-panel image{width:42rpx;height:42rpx}.safety-panel view view{font-size:24rpx;font-weight:800}.safety-panel view text{display:block;margin-top:7rpx;color:#718096;font-size:20rpx;line-height:1.6}
.remote-audio-hero{min-height:334rpx;padding:34rpx;border-radius:18rpx;color:#fff;background:linear-gradient(145deg,#9f2d45,#ec5261 54%,#ff8c69);box-shadow:0 18rpx 42rpx rgba(188,53,74,.2)}.remote-hero-top{display:flex;align-items:center;justify-content:space-between}.remote-vehicle-chip{height:54rpx;padding:0 18rpx;border-radius:14rpx;background:rgba(255,255,255,.16);display:flex;align-items:center;font-size:21rpx;font-weight:750}.remote-vehicle-line{margin-top:25rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.18);display:flex;align-items:center;justify-content:space-between}.remote-vehicle-line text:first-child{font-size:23rpx;font-weight:800}.remote-vehicle-line text:last-child{font-size:19rpx;color:rgba(255,255,255,.72)}
.remote-loading{margin-top:26rpx;display:grid;gap:16rpx}.remote-loading view{height:170rpx}.command-panel{margin-top:22rpx;min-height:92rpx;padding:20rpx 24rpx;border-radius:16rpx;display:flex;align-items:center;gap:18rpx;background:#eaf2ff;color:#1859b8}.command-panel view view{font-size:23rpx;font-weight:800}.command-panel view text{display:block;margin-top:5rpx;font-size:18rpx;opacity:.66}.command-panel.command-completed{background:#e8f9f1;color:#087d58}.command-panel.command-failed,.command-panel.command-expired{background:#fff0f1;color:#b6384a}.command-panel.command-cancelled{background:#f0f2f6;color:#647087}.command-pulse{width:15rpx;height:15rpx;border-radius:50%;background:currentColor;box-shadow:0 0 0 9rpx rgba(23,105,245,.10)}
.authorization-warning{padding:22rpx 24rpx;display:flex;align-items:center;gap:18rpx;background:#fff6e8;border-color:#f4d7a5}.authorization-warning image{width:42rpx;height:42rpx;padding:9rpx;border-radius:12rpx;background:#e89a25}.authorization-warning view view{font-size:24rpx;font-weight:800;color:#8b5809}.authorization-warning view text{display:block;margin-top:5rpx;color:#9a7440;font-size:19rpx}.sound-list{display:grid;gap:16rpx}.sound-card{min-height:176rpx;padding:24rpx 22rpx 24rpx 30rpx;display:grid;grid-template-columns:8rpx 1fr 76rpx;gap:20rpx;align-items:center;overflow:hidden;position:relative;box-shadow:none}.sound-accent{width:8rpx;height:92rpx;border-radius:6rpx;background:#1769f5}.sound-accent.accent-1{background:#12ad7b}.sound-accent.accent-2{background:#f3ad22}.sound-accent.accent-3{background:#f25d66}.sound-category{color:#e44e5f;font-size:18rpx;font-weight:800}.sound-name{margin-top:5rpx;font-size:28rpx;font-weight:800;color:#142038}.sound-description{margin-top:7rpx;color:#718096;font-size:19rpx;line-height:1.45}.sound-meta{margin-top:12rpx;display:flex;gap:18rpx;color:#9aa5b5;font-size:17rpx}.sound-play-button{width:72rpx;height:72rpx;padding:0;border-radius:50%;background:#ef5662;display:flex;align-items:center;justify-content:center;box-shadow:0 10rpx 22rpx rgba(239,86,98,.22)}.sound-play-button image{width:31rpx;height:31rpx}.sound-play-button[disabled]{opacity:.42}.stop-button{margin-top:22rpx;height:88rpx;border-radius:16rpx;background:#fff;color:#c23c4d;border:1rpx solid #f0cbd1;font-size:26rpx;font-weight:800;display:flex;align-items:center;justify-content:center;gap:14rpx}.stop-symbol{width:21rpx;height:21rpx;border-radius:4rpx;background:#d94b5d}.compact-empty{min-height:230rpx}.content-page .action-status{color:#a53647}
