.bind-page { min-height:100vh;padding:0 28rpx 60rpx;background:#f4f7fb }
.detail-header { padding-top:calc(env(safe-area-inset-top) + 24rpx);min-height:150rpx;display:grid;grid-template-columns:64rpx 1fr 176rpx;gap:16rpx;align-items:end;padding-bottom:20rpx }
.back-button{width:58rpx;height:58rpx;border-radius:15rpx;background:#fff;border:1rpx solid #e7ecf3;display:flex;align-items:center;justify-content:center}.back-button image{width:28rpx;height:28rpx}
.detail-title{font-size:36rpx;font-weight:800}.detail-caption{margin-top:6rpx;color:#718096;font-size:21rpx}
.binding-visual{min-height:312rpx;padding:42rpx 40rpx;color:#fff;text-align:center;border-radius:18rpx;background:linear-gradient(145deg,#12295a,#1769f5 62%,#08a7c5);box-shadow:0 18rpx 42rpx rgba(23,105,245,.23)}
.binding-icon{width:88rpx;height:88rpx;margin:0 auto 24rpx;border-radius:20rpx;background:rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center}.binding-icon image{width:44rpx;height:44rpx}.binding-title{font-size:34rpx;font-weight:800}.binding-copy{margin:16rpx auto 0;max-width:560rpx;color:rgba(255,255,255,.7);font-size:22rpx;line-height:1.65}
.form-card{margin-top:20rpx;padding:28rpx;box-shadow:none}.field-label{font-size:24rpx;font-weight:750}.code-input{height:96rpx;margin-top:17rpx;padding:0 24rpx;border-radius:15rpx;background:#f3f6fa;border:2rpx solid #e1e7ef;font-size:34rpx;font-weight:800;letter-spacing:8rpx;text-align:center}.input-placeholder{color:#a0aaba;font-size:25rpx;letter-spacing:0}.field-error{margin-top:13rpx;color:#d84752;font-size:21rpx}.submit-button{margin-top:24rpx}
.steps{margin-top:20rpx;padding:28rpx;box-shadow:none}.steps-title{font-size:27rpx;font-weight:800}.step{display:grid;grid-template-columns:52rpx 1fr;gap:18rpx;align-items:center;margin-top:26rpx}.step>text{width:48rpx;height:48rpx;border-radius:50%;background:#edf3ff;color:#1769f5;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:800}.step view view{font-size:24rpx;font-weight:750}.step view text{display:block;margin-top:5rpx;color:#718096;font-size:19rpx}
