<view class="page-shell home-page">
  <view class="page-header">
    <view>
      <view class="page-heading">超级玩具箱</view>
      <view class="page-caption">车辆数据与车机服务</view>
    </view>
    <view class="wechat-capsule-space"></view>
  </view>

  <block wx:if="{{loading}}">
    <view class="hero-card skeleton"></view>
    <view class="section-heading"><view class="section-title">当前车辆</view></view>
    <view class="loading-grid"><view class="surface skeleton"></view><view class="surface skeleton"></view><view class="surface skeleton"></view><view class="surface skeleton"></view></view>
  </block>

  <view wx:elif="{{error}}" class="surface empty-state">
    <view class="empty-icon"><image src="/assets/icons/wifi-off-blue.png" mode="aspectFit" /></view>
    <view class="empty-title">暂时无法获取车辆数据</view>
    <view class="empty-copy">{{error}}。离线期间不会伪造实时数据，请检查车机网络后重试。</view>
    <button class="secondary-button retry-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{!dashboard.vehicle}}" class="surface empty-state">
    <view class="empty-icon"><image src="/assets/icons/car-blue.png" mode="aspectFit" /></view>
    <view class="empty-title">还没有绑定车辆</view>
    <view class="empty-copy">请在车机端生成一次性绑定码，再回到小程序完成安全绑定。</view>
    <button class="primary-button bind-button" bindtap="bindVehicle">绑定车辆</button>
  </view>

  <block wx:else>
    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="vehicle-name">{{dashboard.vehicle.displayName}}</view>
          <view class="hero-updated">{{dashboard.vehicle.updatedLabel}}</view>
        </view>
        <view class="online-chip">
          <view class="status-dot {{dashboard.vehicle.onlineState}}"></view>
          {{dashboard.vehicle.onlineLabel}}
        </view>
      </view>

      <view class="vehicle-stage">
        <view class="soc-gauge" style="--soc: {{dashboard.vehicle.soc}}%;">
          <view class="soc-gauge-inner">
            <text class="soc-value">{{dashboard.vehicle.socText}}</text>
            <text class="soc-label">当前电量</text>
          </view>
        </view>
        <image class="vehicle-image" src="/assets/vehicle/suv-side.png" mode="aspectFit" />
        <view class="range-block">
          <view class="range-value">{{dashboard.vehicle.rangeText}}</view>
          <view class="range-label">剩余续航 km</view>
        </view>
      </view>

      <view class="state-rail">
        <view class="state-cell"><text>{{dashboard.vehicle.gearLabel}}</text><text>当前挡位</text></view>
        <view class="state-cell"><text>{{dashboard.vehicle.lockLabel}}</text><text>门锁状态</text></view>
        <view class="state-cell"><text>{{dashboard.vehicle.runtimeLabel}}</text><text>车辆状态</text></view>
      </view>
    </view>

    <view class="section-heading">
      <view class="section-title">当前车辆</view>
      <view class="section-action">实时状态</view>
    </view>
    <view class="live-grid">
      <view class="live-card surface environment-card">
        <view><view class="live-label">座舱环境</view><view class="live-title">温度舒适</view></view>
        <view class="temperature-pair"><view><text>{{dashboard.vehicle.insideTempText}}</text><text>车内</text></view><view><text>{{dashboard.vehicle.outsideTempText}}</text><text>车外</text></view></view>
      </view>
      <view class="live-card surface voltage-card">
        <view><view class="live-label">低压电源</view><view class="live-title">{{dashboard.vehicle.voltageText}}</view></view>
        <view class="mini-icon yellow"><image src="/assets/icons/battery-white.png" /></view>
      </view>
      <view class="live-card surface mileage-card">
        <view><view class="live-label">累计里程</view><view class="live-title">{{dashboard.vehicle.mileageText}}</view></view>
        <view class="mini-icon blue"><image src="/assets/icons/gauge-white.png" /></view>
      </view>
      <view class="live-card surface connection-card">
        <view><view class="live-label">车机连接</view><view class="live-title">{{dashboard.vehicle.connectionLabel}}</view></view>
        <view class="mini-icon coral"><image src="/assets/icons/link-white.png" /></view>
      </view>
    </view>

    <view class="section-heading">
      <view class="section-title">今天</view>
      <view class="section-action pressable" bindtap="openTrips">行程详情 ›</view>
    </view>
    <view class="today-card surface pressable" bindtap="openTrips">
      <view class="today-distance"><text>{{dashboard.today.distanceText}}</text><text>km</text><text>今日累计行驶</text></view>
      <view class="today-meta"><text>{{dashboard.today.durationMinutes}}分钟</text><text>平均能耗 {{dashboard.today.consumptionText}}</text></view>
      <view class="trend-line"><view></view></view>
    </view>

    <view class="section-heading">
      <view class="section-title">常用功能</view>
      <view class="section-action">在线时同步</view>
    </view>
    <view class="quick-grid">
      <view wx:for="{{quickActions}}" wx:key="id" class="quick-card surface pressable tone-{{item.tone}}" data-id="{{item.id}}" bindtap="openQuickAction">
        <view class="quick-icon"><image src="/assets/icons/{{item.icon}}-white.png" /></view>
        <view class="quick-title">{{item.title}}</view>
      </view>
    </view>
  </block>
</view>
