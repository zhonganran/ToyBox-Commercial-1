.tools-page { padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.sync-banner { min-height: 150rpx; padding: 26rpx; display: grid; grid-template-columns: 68rpx 1fr auto; gap: 20rpx; align-items: center; color: #ffffff; background: linear-gradient(135deg,#15479a,#1769f5 65%,#08a7c5); border: 0; }
.sync-icon { width: 66rpx; height: 66rpx; border-radius: 16rpx; background: rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; }.sync-icon image { width: 35rpx; height: 35rpx; }
.sync-copy { min-width: 0; }.sync-copy view { font-size: 28rpx; font-weight: 800; }.sync-copy text { display: block; margin-top: 8rpx; max-width: 370rpx; color: rgba(255,255,255,.68); font-size: 19rpx; line-height: 1.5; }
.sync-status { display: flex; align-items: center; font-size: 19rpx; font-weight: 750; white-space: nowrap; }
.tool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.tool-card { position: relative; min-height: 214rpx; padding: 24rpx; overflow: hidden; box-shadow: none; }
.tool-icon { width: 68rpx; height: 68rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; }.tool-icon image { width: 36rpx; height: 36rpx; }
.tool-title { margin-top: 26rpx; font-size: 28rpx; font-weight: 800; }.tool-subtitle { margin-top: 8rpx; max-width: 250rpx; color: #718096; font-size: 19rpx; line-height: 1.45; }
.tool-arrow { position: absolute; width: 34rpx; height: 34rpx; top: 25rpx; right: 24rpx; opacity: .5; }
.tool-blue { background:#eef4ff;border-color:#dce8ff }.tool-blue .tool-icon{background:#1769f5}
.tool-green { background:#edfbf6;border-color:#d5f2e7 }.tool-green .tool-icon{background:#12ad7b}
.tool-coral { background:#fff0f2;border-color:#ffdde1 }.tool-coral .tool-icon{background:#f25d66}
.tool-yellow { background:#fff8e8;border-color:#f8e6b9 }.tool-yellow .tool-icon{background:#f3ad22}
.tool-cyan { background:#eaf9fc;border-color:#d3f0f5 }.tool-cyan .tool-icon{background:#08a7c5}
.tool-violet { background:#f3f0ff;border-color:#e5defe }.tool-violet .tool-icon{background:#6758d7}
.security-note { min-height: 132rpx; padding: 24rpx; display: flex; align-items: center; gap: 20rpx; box-shadow: none; }.security-note image { width: 52rpx; height: 52rpx; }.security-note view view { font-size: 25rpx; font-weight: 800; }.security-note view text { display:block;margin-top:7rpx;color:#718096;font-size:19rpx;line-height:1.5; }
.retry-button { width: 280rpx; margin-top: 28rpx; }
