page {
  min-height: 100%;
  background: #f4f7fb;
  color: #142038;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
}

view, text, image, button, input, scroll-view, map {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 0 28rpx calc(156rpx + env(safe-area-inset-bottom));
}

.page-header {
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  min-height: 150rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.page-heading {
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #142038;
}

.page-caption {
  margin-top: 8rpx;
  color: #718096;
  font-size: 24rpx;
  line-height: 1.4;
}

.wechat-capsule-space {
  width: 176rpx;
  height: 64rpx;
}

.section-heading {
  margin: 28rpx 4rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #142038;
  font-size: 30rpx;
  font-weight: 800;
}

.section-action {
  color: #718096;
  font-size: 22rpx;
}

.surface {
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(25, 54, 104, 0.055);
}

.pressable {
  transition: transform 120ms ease, opacity 120ms ease;
}

.pressable:active {
  transform: scale(0.985);
  opacity: 0.86;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status-dot.online { background: #3de29d; }
.status-dot.offline { background: #aab4c2; }
.status-dot.sleeping { background: #f3ad22; }

.empty-state {
  min-height: 320rpx;
  padding: 56rpx 36rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: #edf3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon image { width: 48rpx; height: 48rpx; }
.empty-title { font-size: 30rpx; font-weight: 800; }
.empty-copy { max-width: 500rpx; margin-top: 12rpx; color: #718096; font-size: 24rpx; line-height: 1.65; }

.primary-button {
  height: 92rpx;
  border-radius: 16rpx;
  background: #1769f5;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(23, 105, 245, 0.22);
}

.secondary-button {
  height: 88rpx;
  border-radius: 16rpx;
  background: #edf3ff;
  color: #1769f5;
  font-size: 28rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skeleton {
  overflow: hidden;
  position: relative;
  background: #e8edf4;
}

.skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.62), transparent);
  animation: skeleton-shimmer 1.35s infinite;
}

@keyframes skeleton-shimmer {
  100% { transform: translateX(100%); }
}
