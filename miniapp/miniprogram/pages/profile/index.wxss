.profile-page { padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.profile-card { min-height: 132rpx; padding: 24rpx; display: grid; grid-template-columns: 86rpx 1fr auto; gap: 20rpx; align-items: center; border-top: 7rpx solid #1769f5; box-shadow:none; }
.vehicle-avatar { width: 82rpx; height: 82rpx; border-radius: 50%; background:#eaf1ff;color:#1769f5;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:800; }
.profile-copy { min-width: 0; }.profile-copy view { overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:29rpx;font-weight:800; }.profile-copy text { display:block;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#718096;font-size:20rpx; }
.auth-chip { padding:10rpx 17rpx;border-radius:24rpx;font-size:20rpx;font-weight:800; }.auth-chip.activated{background:#e7f8f1;color:#087a59}.auth-chip.trial{background:#fff4e2;color:#b96d00}.auth-chip.expired{background:#fff0f2;color:#d84752}
.license-card { min-height:130rpx;margin-top:16rpx;padding:24rpx;color:#fff;background:#173d87;border-color:#173d87;display:flex;align-items:center;justify-content:space-between;box-shadow:none; }.license-card text{color:rgba(255,255,255,.68);font-size:20rpx}.license-card view view{margin-top:8rpx;font-size:29rpx;font-weight:800}.license-shield{width:66rpx;height:66rpx;border:1rpx solid rgba(255,255,255,.35);border-radius:15rpx;display:flex;align-items:center;justify-content:center}.license-shield image{width:38rpx;height:38rpx}
.menu { padding:0 24rpx;box-shadow:none }.menu-row{min-height:114rpx;display:grid;grid-template-columns:62rpx 1fr auto 30rpx;gap:16rpx;align-items:center;border-bottom:1rpx solid #e7ecf3}.menu-row:last-child{border-bottom:0}.menu-icon{width:56rpx;height:56rpx;border-radius:13rpx;display:flex;align-items:center;justify-content:center}.menu-icon image{width:30rpx;height:30rpx}.menu-icon.blue{background:#1769f5}.menu-icon.green{background:#12ad7b}.menu-icon.yellow{background:#f3ad22}.menu-icon.cyan{background:#08a7c5}.menu-icon.coral{background:#f25d66}.menu-icon.violet{background:#6758d7}
.menu-copy view{font-size:25rpx;font-weight:750}.menu-copy text{display:block;margin-top:6rpx;color:#718096;font-size:18rpx}.chevron{width:25rpx;height:25rpx;opacity:.5}.row-status{color:#718096;font-size:18rpx;white-space:nowrap}.row-status.success{color:#0a9b6e;font-weight:700}
.menu-copy { min-width: 0; }.menu-copy text { overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }.retry-button { width:280rpx;margin-top:28rpx }
